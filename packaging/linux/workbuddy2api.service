[Unit]
Description=WorkBuddy2API API gateway and admin service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=workbuddy2api
Group=workbuddy2api
Environment=HOME=/var/lib/workbuddy2api
EnvironmentFile=-/etc/workbuddy2api/workbuddy2api.env
WorkingDirectory=/var/lib/workbuddy2api
ExecStart=/usr/bin/workbuddy2api __serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
