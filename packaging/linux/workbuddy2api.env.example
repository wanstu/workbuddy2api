# WorkBuddy2API Debian package configuration.
# The package creates /etc/workbuddy2api/workbuddy2api.env on first install
# with a random ADMIN_PASSWORD and ADMIN_JWT_SECRET.

ADMIN_HOST=0.0.0.0
ADMIN_PORT=8790

# Standalone package defaults: local SQLite + in-process rate limiting.
ADMIN_DATABASE_URL=sqlite:////var/lib/workbuddy2api/workbuddy.db
ADMIN_REDIS_URL=
ADMIN_GATEWAY_LIMIT_BACKEND=memory

ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ADMIN_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Servers normally do not have a WorkBuddy desktop installation.
ADMIN_DEV_TOOLS=0
